+/* View > Zoom To Fit, to keep its check mark true when a size button makes the window resizable */
+static NSMenuItem *mylinux_zoom_item(NSMenu *menu)
+{
+    for (NSMenuItem *item in [menu itemArray]) {
+        if ([item action] == @selector(zoomToFit:)) {
+            return item;
+        }
+        NSMenuItem *found = [item submenu] ? mylinux_zoom_item([item submenu]) : nil;
+        if (found) {
+            return found;
+        }
+    }
+    return nil;
+}
+
+- (void)sizeButtonSetContentSize:(NSSize)size
+{
+    NSWindow *window = [cocoaView window];
+    if ([window styleMask] & NSWindowStyleMaskFullScreen) {
+        [window toggleFullScreen:nil];
+        return;
+    }
+    mylinux_user_sized = true;
+    if (!([window styleMask] & NSWindowStyleMaskResizable)) {
+        [window setStyleMask:[window styleMask] | NSWindowStyleMaskResizable];
+        if (!zoom_to_fit_item) {
+            zoom_to_fit_item = mylinux_zoom_item([NSApp mainMenu]);
+        }
+        [zoom_to_fit_item setState:NSControlStateValueOn];
+    }
+    NSRect visible = [[window screen] visibleFrame];
+    NSRect frame = [window frame];
+    CGFloat chrome = frame.size.height - [[window contentView] frame].size.height;
+    size.width = MIN(size.width, visible.size.width);
+    size.height = MIN(size.height, visible.size.height - chrome);
+    [window setContentSize:size];
+    frame = [window frame];
+    if (NSMaxX(frame) > NSMaxX(visible)) frame.origin.x = NSMaxX(visible) - frame.size.width;
+    if (NSMaxY(frame) > NSMaxY(visible)) frame.origin.y = NSMaxY(visible) - frame.size.height;
+    if (frame.origin.x < visible.origin.x) frame.origin.x = visible.origin.x;
+    if (frame.origin.y < visible.origin.y) frame.origin.y = visible.origin.y;
+    [window setFrameOrigin:frame.origin];
+}
+
+- (void)sizeButtonLarger:(id)sender
+{
+    NSSize size = [[[cocoaView window] contentView] frame].size;
+    [self sizeButtonSetContentSize:NSMakeSize(round(size.width * 1.1), round(size.height * 1.1))];
+}
+
+/* 10% smaller, down to about 480 points wide */
+- (void)sizeButtonSmaller:(id)sender
+{
+    NSSize size = [[[cocoaView window] contentView] frame].size;
+    NSSize smaller = NSMakeSize(round(size.width / 1.1), round(size.height / 1.1));
+    if (smaller.width < 480) {
+        NSBeep();
+        return;
+    }
+    [self sizeButtonSetContentSize:smaller];
+}
+
 - (void)zoomToFit:(id) sender
 {
     NSWindowStyleMask styleMask = [[cocoaView window] styleMask] ^ NSWindowStyleMaskResizable;
 
     [[cocoaView window] setStyleMask:styleMask];
     [sender setState:styleMask & NSWindowStyleMaskResizable ? NSControlStateValueOn : NSControlStateValueOff];
+    /* turned on by hand: the window keeps the size it has and scales; off: it follows the guest's mode */
+    mylinux_user_sized = (styleMask & NSWindowStyleMaskResizable) != 0;
     [cocoaView resizeWindow];
 }
 
