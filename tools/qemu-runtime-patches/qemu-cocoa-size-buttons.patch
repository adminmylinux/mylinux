+/* myLinux: Machine › Restart. The launcher that started this machine (MYLINUX_LAUNCHER_ID, MYLINUX_LINK_SCOPE, APP_ID
+ * from its Runner) shuts it down and starts it again: a new QEMU, so a runtime installed since is used (Reset only
+ * reboots the guest in this one). Only shown when the launcher started the machine.
+ */
+static bool mylinux_restart_available(void)
+{
+    return getenv("MYLINUX_LAUNCHER_ID") && getenv("MYLINUX_LINK_SCOPE") && getenv("APP_ID");
+}
+
+/* MachineLink's request to the launcher: {id, action}; with the launcher not running, say so and offer to open it */
+static void mylinux_ask_launcher(NSString *action)
+{
+    NSString *launcher = [NSString stringWithUTF8String:getenv("MYLINUX_LAUNCHER_ID")];
+    if ([[NSRunningApplication runningApplicationsWithBundleIdentifier:launcher] count] == 0) {
+        bool restart = [action isEqualToString:@"restart"];
+        NSAlert *alert = [[NSAlert alloc] init];
+        bool apps = [action isEqualToString:@"apps"];
+        bool claude = [action isEqualToString:@"claude"];
+        [alert setMessageText:restart ? @"Restart needs myLinux Launcher" : apps ? @"Apps needs myLinux Launcher"
+                              : claude ? @"Claude Install needs myLinux Launcher" : @"Cloud Folders needs myLinux Launcher"];
+        [alert setInformativeText:restart ? @"Open myLinux Launcher and press Restart on this machine, or use Power Down and then Start."
+                                          : apps ? @"Open myLinux Launcher, then press Shift-Command-A in this window again."
+                                          : claude ? @"Open myLinux Launcher, then choose Claude Install… in this window again."
+                                                 : @"Open myLinux Launcher and choose Cloud Folders on this machine's page."];
+        [alert addButtonWithTitle:@"Open myLinux Launcher"];
+        [alert addButtonWithTitle:@"Cancel"];
+        if ([alert runModal] == NSAlertFirstButtonReturn) {
+            NSURL *url = [[NSWorkspace sharedWorkspace] URLForApplicationWithBundleIdentifier:launcher];
+            if (url) {
+                [[NSWorkspace sharedWorkspace] openURL:url];
+            }
+        }
+        [alert release];
+        return;
+    }
+    // macOS 14's cooperative activation: the launcher may come to the front (its dialog takes the keyboard)
+    if (@available(macOS 14.0, *)) {
+        [NSApp yieldActivationToApplicationWithBundleIdentifier:launcher];
+    }
+    [[NSDistributedNotificationCenter defaultCenter]
+        postNotificationName:@"dev.mylinux.machine.request"
+                      object:[NSString stringWithUTF8String:getenv("MYLINUX_LINK_SCOPE")]
+                    userInfo:@{ @"id": [NSString stringWithUTF8String:getenv("APP_ID")], @"action": action }
+          deliverImmediately:YES];
+}
+
+- (void)mylinuxRestart:(id)sender
+{
+    mylinux_ask_launcher(@"restart");
+}
