+static const char *mylinux_env(const char *name)
+{
+    const char *v = getenv(name);
+    return v && *v ? v : NULL;
+}
+static bool mylinux_size_buttons(void) { return mylinux_env("MYLINUX_SIZE_BUTTONS") != NULL; }
+/*
+ * The window starts fixed, as it always did: a guest's early console takes the window's size for its own, and a
+ * first-boot screen drawn in a window of another size comes out wrong. When the guest reaches its desktop's mode
+ * (MYLINUX_DESKTOP_MODE, "WxH" in guest pixels, from run.sh and run-omarchy.sh) the window becomes resizable, so
+ * Window > Fill, tiling and a drag work from then on; until the user sizes it, it keeps following the mode.
+ */
+/*
+ * The window opens on the display its mode was made for (MYLINUX_WINDOW_DISPLAY, a CGDirectDisplayID that run.sh and
+ * run-omarchy.sh pass along with the resolution they chose for it), not wherever macOS puts a new app's window: on
+ * another display (a Retina mode on a 1x screen, or the reverse) the window is twice or half the size it should be.
+ */
+static void mylinux_center(NSWindow *window)
+{
+    /* NSWindow's -center uses the main screen (the one with the menu bar's focus), which is how the window used to
+     * land on the other display at every mode change */
+    NSScreen *target = [window screen] ?: [NSScreen mainScreen];
+    const char *want = mylinux_env("MYLINUX_WINDOW_DISPLAY");
+    if (want) {
+        unsigned long id = strtoul(want, NULL, 10);
+        for (NSScreen *s in [NSScreen screens]) {
+            if ([[[s deviceDescription] objectForKey:@"NSScreenNumber"] unsignedLongValue] == id) {
+                target = s;
+            }
+        }
+    } else {
+        [window center];
+        return;
+    }
+    NSRect v = [target visibleFrame], f = [window frame];
+    /* like -center: horizontally centred, a little above the middle, and the title bar below the top */
+    CGFloat y = NSMidY(v) - f.size.height / 2 + (v.size.height - f.size.height) / 6;
+    if (y + f.size.height > NSMaxY(v)) {
+        y = NSMaxY(v) - f.size.height;
+    }
+    [window setFrameOrigin:NSMakePoint(NSMidX(v) - f.size.width / 2, y)];
+}
+
+static NSMenuItem *mylinux_zoom_item(NSMenu *menu);
+static void mylinux_desktop_reached(NSWindow *window, int w, int h)
+{
+    const char *want = mylinux_env("MYLINUX_DESKTOP_MODE");
+    int dw = 0, dh = 0;
+    if (!mylinux_size_buttons() || !want || sscanf(want, "%dx%d", &dw, &dh) != 2 || w != dw || h != dh ||
+        ([window styleMask] & NSWindowStyleMaskResizable)) {
+        return;
+    }
+    /* a window larger than its screen (a mode made for another display) stays fixed, as before: made resizable,
+     * macOS shrinks it to a default size at once and the guest would follow that down */
+    NSRect visible = [[window screen] visibleFrame];
+    if ([window frame].size.width > visible.size.width + 1 || [window frame].size.height > visible.size.height + 1) {
+        return;
+    }
+    [window setStyleMask:[window styleMask] | NSWindowStyleMaskResizable];
+    if (!zoom_to_fit_item) {
+        zoom_to_fit_item = mylinux_zoom_item([NSApp mainMenu]);
+    }
+    [zoom_to_fit_item setState:NSControlStateValueOn];
+}
+
+static bool mylinux_follows_mode(NSWindow *window)
+{
+    return mylinux_size_buttons() && !mylinux_user_sized && !([window styleMask] & NSWindowStyleMaskFullScreen);
+}
+static bool mylinux_session(void) { return mylinux_env("MYLINUX_SESSION_CMD") != NULL; }
+/*
+ * myLinux: MYLINUX_COMMANDS_MENU gives a desktop without Omarchy's session tool (Arch with Plasma) the ⌘ menu too:
+ * the launcher's commands it names, space separated (apps claude snippets cloud share; 1 for all), and no session part.
+ * Omarchy's (MYLINUX_SESSION_CMD) has them all and the session.
+ */
+static bool mylinux_commands_menu(void) { return mylinux_session() || mylinux_env("MYLINUX_COMMANDS_MENU") != NULL; }
+static bool mylinux_command_shown(const char *name)
+{
+    if (mylinux_session()) {
+        return true;
+    }
+    const char *list = mylinux_env("MYLINUX_COMMANDS_MENU");
+    if (!list) {
+        return false;
+    }
+    if (strcmp(list, "1") == 0) {
+        return true;
+    }
+    size_t n = strlen(name);
+    for (const char *p = strstr(list, name); p; p = strstr(p + n, name)) {
+        if ((p == list || p[-1] == ' ') && (p[n] == '\0' || p[n] == ' ')) {
+            return true;
+        }
+    }
+    return false;
+}
