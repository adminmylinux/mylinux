+- (void)addLauncherCommands:(NSMenu *)menu
+{
+    if (!mylinux_restart_available()) {
+        return;
+    }
+    NSMenuItem *item;
+    if (mylinux_command_shown("apps")) {
+        item = [menu addItemWithTitle:@"Apps…" action:@selector(mylinuxApps:) keyEquivalent:@"A"];
+        [item setKeyEquivalentModifierMask:NSEventModifierFlagCommand];
+        [item setTarget:self];
+    }
+    if (mylinux_command_shown("claude")) {
+        item = [menu addItemWithTitle:@"Claude Install…" action:@selector(mylinuxClaude:) keyEquivalent:@""];
+        [item setTarget:self];
+    }
+    if (mylinux_command_shown("snippets")) {
+        item = [menu addItemWithTitle:@"Snippets…" action:@selector(mylinuxSnippets:) keyEquivalent:@""];
+        [item setTarget:self];
+    }
+    if (mylinux_command_shown("cloud")) {
+        item = [menu addItemWithTitle:@"Cloud Folders…" action:@selector(mylinuxCloudFolders:) keyEquivalent:@"P"];
+        [item setKeyEquivalentModifierMask:NSEventModifierFlagCommand];
+        [item setTarget:self];
+    }
+    if (mylinux_command_shown("share")) {
+        item = [menu addItemWithTitle:@"Mount a Share…" action:@selector(mylinuxMountShare:) keyEquivalent:@""];
+        [item setTarget:self];
+    }
+}
