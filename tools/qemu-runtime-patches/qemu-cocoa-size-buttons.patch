+- (void)installSizeButtons
+{
+    if (!mylinux_size_buttons() && !mylinux_session()) {
+        return;
+    }
+    NSToolbar *toolbar = [[NSToolbar alloc] initWithIdentifier:@"mylinux-window"];
+    [toolbar setDelegate:self];
+    [toolbar setDisplayMode:NSToolbarDisplayModeIconOnly];
+    [toolbar setAllowsUserCustomization:NO];
+    if (mylinux_session()) {
+        [toolbar setCenteredItemIdentifier:@"mylinux.session"];
+    }
+    [[cocoaView window] setToolbarStyle:NSWindowToolbarStyleUnifiedCompact];
+    [[cocoaView window] setToolbar:toolbar];
+}
+
+- (NSArray<NSToolbarItemIdentifier> *)toolbarDefaultItemIdentifiers:(NSToolbar *)toolbar
+{
+    NSMutableArray *ids = [NSMutableArray arrayWithObject:NSToolbarFlexibleSpaceItemIdentifier];
+    if (mylinux_session()) {
+        [ids addObject:@"mylinux.session"];
+        [ids addObject:NSToolbarFlexibleSpaceItemIdentifier];
+    }
+    if (mylinux_size_buttons()) {
+        [ids addObjectsFromArray:@[@"mylinux.smaller", @"mylinux.larger", @"mylinux.fullscreen"]];
+    }
+    return ids;
+}
+
+- (NSArray<NSToolbarItemIdentifier> *)toolbarAllowedItemIdentifiers:(NSToolbar *)toolbar
+{
+    return [self toolbarDefaultItemIdentifiers:toolbar];
+}
+
+- (NSToolbarItem *)toolbar:(NSToolbar *)toolbar itemForItemIdentifier:(NSToolbarItemIdentifier)identifier
+    willBeInsertedIntoToolbar:(BOOL)flag
+{
+    NSString *symbol = nil, *tip = nil;
+    SEL action = NULL;
+    if ([identifier isEqualToString:@"mylinux.session"]) {
+        NSMenuToolbarItem *item = [[NSMenuToolbarItem alloc] initWithItemIdentifier:identifier];
+        [item setImage:[NSImage imageWithSystemSymbolName:@"clock.arrow.circlepath" accessibilityDescription:@"Session"]];
+        [item setLabel:@"Session"];
+        [item setToolTip:@"Save and restore the Omarchy session, and how often it is saved"];
+        [item setShowsIndicator:YES];
+        [item setMenu:[self sessionMenuForPanel:NO]];
+        return item;
+    } else if ([identifier isEqualToString:@"mylinux.smaller"]) {
+        symbol = @"minus"; tip = @"Smaller window (-10%)"; action = @selector(sizeButtonSmaller:);
+    } else if ([identifier isEqualToString:@"mylinux.larger"]) {
+        symbol = @"plus"; tip = @"Larger window (+10%)"; action = @selector(sizeButtonLarger:);
+    } else if ([identifier isEqualToString:@"mylinux.fullscreen"]) {
+        symbol = @"arrow.up.left.and.arrow.down.right"; tip = @"Full screen"; action = @selector(doToggleFullScreen:);
+    } else {
+        return nil;
+    }
+    NSToolbarItem *item = [[NSToolbarItem alloc] initWithItemIdentifier:identifier];
+    [item setImage:[NSImage imageWithSystemSymbolName:symbol accessibilityDescription:tip]];
+    [item setLabel:tip];
+    [item setToolTip:tip];
+    [item setBordered:YES];
+    [item setTarget:self];
+    [item setAction:action];
+    return item;
+}
+
+/* the Session menu: rebuilt from the guest's status file each time it opens */
+- (NSMenu *)sessionMenuForPanel:(BOOL)panel
+{
+    NSMenu **slot = panel ? &session_panel_menu : &session_menu;
+    if (!*slot) {
+        *slot = [[NSMenu alloc] initWithTitle:@"Session"];
+        [*slot setDelegate:self];
+        [*slot setAutoenablesItems:NO];
+    }
+    return *slot;
+}
+
+- (NSDictionary *)sessionStatus
+{
+    const char *path = mylinux_env("MYLINUX_SESSION_STATUS");
+    if (!path) {
+        return nil;
+    }
+    NSData *data = [NSData dataWithContentsOfFile:[NSString stringWithUTF8String:path]];
+    if (!data) {
+        return nil;
+    }
+    id object = [NSJSONSerialization JSONObjectWithData:data options:0 error:NULL];
+    return [object isKindOfClass:[NSDictionary class]] ? object : nil;
+}
+
+- (void)menuNeedsUpdate:(NSMenu *)menu
+{
+    if (menu != session_menu && menu != session_panel_menu) {
+        return;
+    }
+    [menu removeAllItems];
+    if (menu == session_panel_menu) {
+        /* a pull-down button shows its first item as its face */
+        NSMenuItem *face = [[[NSMenuItem alloc] initWithTitle:@"" action:nil keyEquivalent:@""] autorelease];
+        [face setImage:[NSImage imageWithSystemSymbolName:@"clock.arrow.circlepath" accessibilityDescription:@"Session"]];
+        [menu addItem:face];
+    }
+    NSMenuItem *item;
+    item = [menu addItemWithTitle:@"Save Session Now" action:@selector(sessionSave:) keyEquivalent:@""];
+    [item setTarget:self];
+    item = [menu addItemWithTitle:@"Restore Session" action:@selector(sessionRestore:) keyEquivalent:@""];
+    [item setTarget:self];
+    [menu addItem:[NSMenuItem separatorItem]];
+    NSDictionary *status = [self sessionStatus];
+    NSString *info = status ? @"Nothing saved yet" : @"Session tool not installed in Omarchy yet";
+    long minutes = 1;
+    if (status) {
+        id last = status[@"last_saved"], windows = status[@"windows"];
+        if ([last isKindOfClass:[NSString class]] && [last length] >= 16) {
+            long n = [windows respondsToSelector:@selector(longValue)] ? [windows longValue] : 0;
+            info = [NSString stringWithFormat:@"Last saved %@, %ld window%@",
+                    [last substringWithRange:NSMakeRange(11, 5)], n, n == 1 ? @"" : @"s"];
+        }
+        if ([status[@"interval_minutes"] respondsToSelector:@selector(longValue)]) {
+            minutes = [status[@"interval_minutes"] longValue];
+        }
+    }
+    item = [menu addItemWithTitle:info action:nil keyEquivalent:@""];
+    [item setEnabled:NO];
+    [menu addItem:[NSMenuItem separatorItem]];
+    NSMenu *every = [[[NSMenu alloc] initWithTitle:@"Save Every"] autorelease];
+    [every setAutoenablesItems:NO];
+    long choices[] = { 0, 1, 2, 5, 15 };
+    for (size_t i = 0; i < sizeof(choices) / sizeof(choices[0]); i++) {
+        NSString *title = choices[i] == 0 ? @"Off"
+            : [NSString stringWithFormat:@"%ld minute%@", choices[i], choices[i] == 1 ? @"" : @"s"];
+        NSMenuItem *choice = [every addItemWithTitle:title action:@selector(sessionInterval:) keyEquivalent:@""];
+        [choice setTarget:self];
+        [choice setTag:choices[i]];
+        [choice setState:minutes == choices[i] ? NSControlStateValueOn : NSControlStateValueOff];
+    }
+    item = [menu addItemWithTitle:@"Save Every" action:nil keyEquivalent:@""];
+    [menu setSubmenu:every forItem:item];
+}
+
+- (void)sessionCommand:(NSArray<NSString *> *)words
+{
+    const char *command = mylinux_env("MYLINUX_SESSION_CMD");
+    const char *share = mylinux_env("MYLINUX_SESSION_SHARE");
+    if (!command || !share) {
+        return;
+    }
+    /* the helper is run directly, as an argument list: a space or a quote in the app's or the share's path is
+     * only a character, and UTF-8 paths arrive as they are */
+    NSString *helper = [NSString stringWithUTF8String:command];
+    NSString *folder = [NSString stringWithUTF8String:share];
+    if (!helper || !folder) {
+        return;
+    }
+    NSMutableArray<NSString *> *arguments = [NSMutableArray arrayWithObject:folder];
+    [arguments addObjectsFromArray:words];
+    [NSTask launchedTaskWithExecutableURL:[NSURL fileURLWithPath:helper] arguments:arguments
+                                    error:NULL terminationHandler:nil];
+}
+
+- (void)sessionSave:(id)sender { [self sessionCommand:@[@"save"]]; }
+- (void)sessionRestore:(id)sender { [self sessionCommand:@[@"restore"]]; }
+- (void)sessionInterval:(id)sender
+{
+    long minutes = [sender tag];
+    [self sessionCommand:@[@"interval", minutes ? [NSString stringWithFormat:@"%ld", minutes] : @"off"]];
+}
