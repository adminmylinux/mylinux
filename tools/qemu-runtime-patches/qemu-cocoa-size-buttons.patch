+/*
+ * Fill Screen, as in the launcher's terminal windows: the window takes the whole screen below the menu bar and
+ * beside the Dock, title bar and all (full screen is the button next to it); pressed again while it still fills
+ * the screen, it goes back to the size and place it had.
+ * A guest that follows the window (Omarchy's and Arch's desktops) takes the new size for its mode within a moment.
+ * One that keeps its mode (myLinux, which is zoomed; a console before the desktop is up, which falls back to a
+ * mode of another shape) would be drawn stretched: after that moment its window takes the picture's shape again,
+ * as large as the screen allows, so "fills" means as wide or as high as the screen.
+ */
+- (void)sizeButtonFill:(id)sender
+{
+    static NSRect before;
+    static bool filled;
+    NSWindow *window = [cocoaView window];
+    if ([window styleMask] & NSWindowStyleMaskFullScreen) {
+        [window toggleFullScreen:nil];
+        return;
+    }
+    NSRect visible = [[window screen] visibleFrame];
+    NSRect frame = [window frame];
+    CGFloat chrome = frame.size.height - [[window contentView] frame].size.height;
+    bool fills = fabs(frame.size.width - visible.size.width) < 2 || fabs(frame.size.height - visible.size.height) < 2;
+    if (filled && fills) {
+        filled = false;
+        [self sizeButtonSetContentSize:NSMakeSize(before.size.width, before.size.height - chrome)];
+        [window setFrameOrigin:before.origin];
+        return;
+    }
+    before = frame;
+    filled = true;
+    [self sizeButtonSetContentSize:NSMakeSize(visible.size.width, visible.size.height - chrome)];
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(2 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
+        NSWindow *w = [cocoaView window];
+        if (!filled || ([w styleMask] & NSWindowStyleMaskFullScreen)) {
+            return;
+        }
+        NSSize content = [[w contentView] frame].size;
+        NSSize fitted = [cocoaView fixAspectRatio:content];
+        if (fabs(fitted.width - content.width) > 2 || fabs(fitted.height - content.height) > 2) {
+            [self sizeButtonSetContentSize:fitted];
+            /* in the middle of the screen's width, under the menu bar */
+            NSRect v = [[w screen] visibleFrame], f = [w frame];
+            [w setFrameOrigin:NSMakePoint(NSMidX(v) - f.size.width / 2, NSMaxY(v) - f.size.height)];
+        }
+    });
+}
