+- (void)installSizeButtons
+{
+    NSView *strip = [[NSView alloc] initWithFrame:NSMakeRect(0, 0, 104, 26)];
+    NSArray *specs = @[
+        @[@"minus", @"Back to the starting size", @"sizeButtonBase:"],
+        @[@"plus", @"Larger window (+10%)", @"sizeButtonLarger:"],
+        @[@"arrow.up.left.and.arrow.down.right", @"Full screen", @"doToggleFullScreen:"],
+    ];
+    CGFloat x = 0;
+    for (NSArray *spec in specs) {
+        NSImage *image = [NSImage imageWithSystemSymbolName:spec[0] accessibilityDescription:spec[1]];
+        NSButton *button = [NSButton buttonWithImage:image target:self action:NSSelectorFromString(spec[2])];
+        [button setBezelStyle:NSBezelStyleToolbar];
+        [button setToolTip:spec[1]];
+        [button setFrame:NSMakeRect(x, 1, 30, 24)];
+        [strip addSubview:button];
+        x += 34;
+    }
+    [strip setFrame:NSMakeRect(0, 0, x + 6, 26)];
+    NSTitlebarAccessoryViewController *accessory = [[NSTitlebarAccessoryViewController alloc] init];
+    [accessory setView:strip];
+    [accessory setLayoutAttribute:NSLayoutAttributeRight];
+    [[cocoaView window] addTitlebarAccessoryViewController:accessory];
+}
+
+- (void)showFullScreenPanel
+{
+    if (!fullscreen_panel) {
+        NSImage *image = [NSImage imageWithSystemSymbolName:@"arrow.down.right.and.arrow.up.left"
+                                   accessibilityDescription:@"Exit full screen"];
+        NSButton *button = [NSButton buttonWithImage:image target:self action:@selector(doToggleFullScreen:)];
+        [button setBezelStyle:NSBezelStyleToolbar];
+        [button setToolTip:@"Exit full screen (Control+Command+F)"];
+        [button setFrame:NSMakeRect(24, 6, 32, 26)];
+        /* a grip to the left of the button: the panel moves when dragged by its background, so it can be pulled
+         * out of the way (three dots mark the grip) */
+        NSTextField *grip = [NSTextField labelWithString:@"\u22EE"];
+        [grip setFont:[NSFont systemFontOfSize:13]];
+        [grip setTextColor:[NSColor colorWithWhite:1 alpha:0.6]];
+        [grip setFrame:NSMakeRect(6, 8, 14, 22)];
+        [grip setToolTip:@"Drag to move"];
+        fullscreen_panel = [[NSPanel alloc] initWithContentRect:NSMakeRect(0, 0, 62, 38)
+            styleMask:NSWindowStyleMaskBorderless | NSWindowStyleMaskNonactivatingPanel | NSWindowStyleMaskUtilityWindow
+            backing:NSBackingStoreBuffered defer:NO];
+        [fullscreen_panel setMovableByWindowBackground:YES];
+        [fullscreen_panel setLevel:NSStatusWindowLevel];
+        [fullscreen_panel setCollectionBehavior:NSWindowCollectionBehaviorCanJoinAllSpaces |
+                                                NSWindowCollectionBehaviorFullScreenAuxiliary |
+                                                NSWindowCollectionBehaviorStationary];
+        [fullscreen_panel setOpaque:NO];
+        [fullscreen_panel setBackgroundColor:[NSColor colorWithWhite:0.15 alpha:0.8]];
+        [fullscreen_panel setHidesOnDeactivate:NO];
+        [fullscreen_panel setFloatingPanel:YES];
+        [[fullscreen_panel contentView] setWantsLayer:YES];
+        [[[fullscreen_panel contentView] layer] setCornerRadius:8];
+        [[fullscreen_panel contentView] addSubview:grip];
+        [[fullscreen_panel contentView] addSubview:button];
+    }
+    /* top right corner, 24 points below the menu bar and 2 in from the edge; where the user dragged it last time
+     * when that is still on this screen */
+    NSScreen *screen = [[cocoaView window] screen];
+    NSRect frame = [screen frame];
+    if (!fullscreen_panel_placed || !NSContainsRect(frame, [fullscreen_panel frame])) {
+        CGFloat top = MIN(NSMaxY([screen visibleFrame]), NSMaxY(frame) - [screen safeAreaInsets].top);
+        [fullscreen_panel setFrameOrigin:NSMakePoint(NSMaxX(frame) - 62 - 2, top - 38 - 24)];
+        fullscreen_panel_placed = true;
+    }
+    [fullscreen_panel orderFront:nil];
+}
