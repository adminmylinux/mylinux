 /* Stretches video to fit host monitor size */
+/*
+ * myLinux: three buttons in the window's title bar, at the right. Minus puts the window back to the content size it
+ * came up with, plus makes it 10% larger, the third is full screen. The first two turn Zoom To Fit on (the window
+ * becomes resizable and the picture scales to it); with a guest that follows the window's size, that is how the
+ * desktop gets more room. The window is kept inside its screen.
+ */
+static NSSize size_button_base;
+/* myLinux: a small floating button in the top right corner while in full screen, since the title bar and its
+ * buttons are hidden there; Control+Command+F does the same from the keyboard. */
+static NSPanel *fullscreen_panel;
+static bool fullscreen_panel_placed;
+/* the content size before full screen, restored on the way out (the guest sits at the display's resolution then, and
+ * without this the fixed window would take that size and fill the screen) */
+static NSSize prefullscreen_size;
