 /* Stretches video to fit host monitor size */
+/*
+ * myLinux: the window's own controls, in a toolbar. At the right: minus (10% smaller), plus (10% larger) and full
+ * screen; the first two turn Zoom To Fit on (the window becomes resizable and the picture scales to it: myLinux's
+ * desktop is zoomed, and a guest that follows the window's size, Omarchy, gets more or less room that way). Centred: a Session
+ * menu, when MYLINUX_SESSION_CMD names a helper that hands "save", "restore" or "interval N" to the guest (run
+ * without a shell, with the share folder from MYLINUX_SESSION_SHARE as its first argument; MYLINUX_SESSION_STATUS
+ * is the status file the guest keeps for the menu). The size buttons are
+ * only there with MYLINUX_SIZE_BUTTONS set (run.sh, run-omarchy.sh); a window without either keeps its plain title bar.
+ * In full screen, where the title bar is hidden, a small floating box carries the Session menu and an exit button.
+ */
+static NSMenuItem *zoom_to_fit_item;
+static NSPanel *fullscreen_panel;
+static bool fullscreen_panel_placed;
+static NSSize prefullscreen_size;
+static NSMenu *session_menu, *session_panel_menu;
+
+static const char *mylinux_env(const char *name)
+{
+    const char *v = getenv(name);
+    return v && *v ? v : NULL;
+}
+static bool mylinux_size_buttons(void) { return mylinux_env("MYLINUX_SIZE_BUTTONS") != NULL; }
+static bool mylinux_follows_mode(NSWindow *window)
+{
+    return mylinux_size_buttons() && !mylinux_user_sized && !([window styleMask] & NSWindowStyleMaskFullScreen);
+}
+static bool mylinux_session(void) { return mylinux_env("MYLINUX_SESSION_CMD") != NULL; }
