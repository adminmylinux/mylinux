+/* the Session menu: rebuilt from the guest's status file each time it opens */
+- (NSMenu *)sessionMenuForPanel:(BOOL)panel
+{
+    NSMenu **slot = panel ? &session_panel_menu : &session_menu;
+    if (!*slot) {
+        *slot = [[NSMenu alloc] initWithTitle:@"Session"];
+        [*slot setDelegate:self];
+        [*slot setAutoenablesItems:NO];
+    }
+    return *slot;
+}
+
+- (NSDictionary *)sessionStatus
+{
+    const char *path = mylinux_env("MYLINUX_SESSION_STATUS");
+    if (!path) {
+        return nil;
+    }
+    NSData *data = [NSData dataWithContentsOfFile:[NSString stringWithUTF8String:path]];
+    if (!data) {
+        return nil;
+    }
+    id object = [NSJSONSerialization JSONObjectWithData:data options:0 error:NULL];
+    return [object isKindOfClass:[NSDictionary class]] ? object : nil;
+}
