 /* Stretches video to fit host monitor size */
+/*
+ * myLinux: the window's own controls, in a toolbar. At the right: minus (back to the content size the window came up
+ * with), plus (10% larger) and full screen; the first two turn Zoom To Fit on (the window becomes resizable and the
+ * picture scales to it), and a guest that follows the window's size gets more room that way. Centred: a Session
+ * menu, when MYLINUX_SESSION_CMD names a command that hands "save", "restore" or "interval N" to the guest (through
+ * the share folder; MYLINUX_SESSION_STATUS is the status file the guest keeps for the menu). The size buttons are
+ * only there with MYLINUX_SIZE_BUTTONS set (run-omarchy.sh); a window without either keeps its plain title bar.
+ * In full screen, where the title bar is hidden, a small floating box carries the Session menu and an exit button.
+ */
+static NSSize size_button_base;
+static NSPanel *fullscreen_panel;
+static bool fullscreen_panel_placed;
+static NSSize prefullscreen_size;
+static NSMenu *session_menu, *session_panel_menu;
+
+static const char *mylinux_env(const char *name)
+{
+    const char *v = getenv(name);
+    return v && *v ? v : NULL;
+}
+static bool mylinux_size_buttons(void) { return mylinux_env("MYLINUX_SIZE_BUTTONS") != NULL; }
+static bool mylinux_session(void) { return mylinux_env("MYLINUX_SESSION_CMD") != NULL; }
+
+- (void)installSizeButtons
+{
+    if (!mylinux_size_buttons() && !mylinux_session()) {
+        return;
+    }
+    NSToolbar *toolbar = [[NSToolbar alloc] initWithIdentifier:@"mylinux-window"];
+    [toolbar setDelegate:self];
+    [toolbar setDisplayMode:NSToolbarDisplayModeIconOnly];
+    [toolbar setAllowsUserCustomization:NO];
+    if (mylinux_session()) {
+        [toolbar setCenteredItemIdentifier:@"mylinux.session"];
+    }
+    [[cocoaView window] setToolbarStyle:NSWindowToolbarStyleUnifiedCompact];
+    [[cocoaView window] setToolbar:toolbar];
+}
+
+- (NSArray<NSToolbarItemIdentifier> *)toolbarDefaultItemIdentifiers:(NSToolbar *)toolbar
+{
+    NSMutableArray *ids = [NSMutableArray arrayWithObject:NSToolbarFlexibleSpaceItemIdentifier];
+    if (mylinux_session()) {
+        [ids addObject:@"mylinux.session"];
+        [ids addObject:NSToolbarFlexibleSpaceItemIdentifier];
+    }
+    if (mylinux_size_buttons()) {
+        [ids addObjectsFromArray:@[@"mylinux.smaller", @"mylinux.larger", @"mylinux.fullscreen"]];
+    }
+    return ids;
+}
+
+- (NSArray<NSToolbarItemIdentifier> *)toolbarAllowedItemIdentifiers:(NSToolbar *)toolbar
+{
+    return [self toolbarDefaultItemIdentifiers:toolbar];
+}
+
+- (NSToolbarItem *)toolbar:(NSToolbar *)toolbar itemForItemIdentifier:(NSToolbarItemIdentifier)identifier
+    willBeInsertedIntoToolbar:(BOOL)flag
+{
+    NSString *symbol = nil, *tip = nil;
+    SEL action = NULL;
+    if ([identifier isEqualToString:@"mylinux.session"]) {
+        NSMenuToolbarItem *item = [[NSMenuToolbarItem alloc] initWithItemIdentifier:identifier];
+        [item setImage:[NSImage imageWithSystemSymbolName:@"clock.arrow.circlepath" accessibilityDescription:@"Session"]];
+        [item setLabel:@"Session"];
+        [item setToolTip:@"Save and restore the Omarchy session, and how often it is saved"];
+        [item setShowsIndicator:YES];
+        [item setMenu:[self sessionMenuForPanel:NO]];
+        return item;
+    } else if ([identifier isEqualToString:@"mylinux.smaller"]) {
+        symbol = @"minus"; tip = @"Back to the starting size"; action = @selector(sizeButtonBase:);
+    } else if ([identifier isEqualToString:@"mylinux.larger"]) {
+        symbol = @"plus"; tip = @"Larger window (+10%)"; action = @selector(sizeButtonLarger:);
+    } else if ([identifier isEqualToString:@"mylinux.fullscreen"]) {
+        symbol = @"arrow.up.left.and.arrow.down.right"; tip = @"Full screen"; action = @selector(doToggleFullScreen:);
+    } else {
+        return nil;
+    }
+    NSToolbarItem *item = [[NSToolbarItem alloc] initWithItemIdentifier:identifier];
+    [item setImage:[NSImage imageWithSystemSymbolName:symbol accessibilityDescription:tip]];
+    [item setLabel:tip];
+    [item setToolTip:tip];
+    [item setBordered:YES];
+    [item setTarget:self];
+    [item setAction:action];
+    return item;
+}
+
+/* the Session menu: rebuilt from the guest's status file each time it opens */
+- (NSMenu *)sessionMenuForPanel:(BOOL)panel
+{
+    NSMenu **slot = panel ? &session_panel_menu : &session_menu;
+    if (!*slot) {
+        *slot = [[NSMenu alloc] initWithTitle:@"Session"];
+        [*slot setDelegate:self];
+        [*slot setAutoenablesItems:NO];
+    }
+    return *slot;
+}
+
+- (NSDictionary *)sessionStatus
+{
+    const char *path = mylinux_env("MYLINUX_SESSION_STATUS");
+    if (!path) {
+        return nil;
+    }
+    NSData *data = [NSData dataWithContentsOfFile:[NSString stringWithUTF8String:path]];
+    if (!data) {
+        return nil;
+    }
+    id object = [NSJSONSerialization JSONObjectWithData:data options:0 error:NULL];
+    return [object isKindOfClass:[NSDictionary class]] ? object : nil;
+}
+
+- (void)menuNeedsUpdate:(NSMenu *)menu
+{
+    if (menu != session_menu && menu != session_panel_menu) {
+        return;
+    }
+    [menu removeAllItems];
+    if (menu == session_panel_menu) {
+        /* a pull-down button shows its first item as its face */
+        NSMenuItem *face = [[[NSMenuItem alloc] initWithTitle:@"" action:nil keyEquivalent:@""] autorelease];
+        [face setImage:[NSImage imageWithSystemSymbolName:@"clock.arrow.circlepath" accessibilityDescription:@"Session"]];
+        [menu addItem:face];
+    }
+    NSMenuItem *item;
+    item = [menu addItemWithTitle:@"Save Session Now" action:@selector(sessionSave:) keyEquivalent:@""];
+    [item setTarget:self];
+    item = [menu addItemWithTitle:@"Restore Session" action:@selector(sessionRestore:) keyEquivalent:@""];
+    [item setTarget:self];
+    [menu addItem:[NSMenuItem separatorItem]];
+    NSDictionary *status = [self sessionStatus];
+    NSString *info = status ? @"Nothing saved yet" : @"Session tool not installed in Omarchy yet";
+    long minutes = 1;
+    if (status) {
+        id last = status[@"last_saved"], windows = status[@"windows"];
+        if ([last isKindOfClass:[NSString class]] && [last length] >= 16) {
+            long n = [windows respondsToSelector:@selector(longValue)] ? [windows longValue] : 0;
+            info = [NSString stringWithFormat:@"Last saved %@, %ld window%@",
+                    [last substringWithRange:NSMakeRange(11, 5)], n, n == 1 ? @"" : @"s"];
+        }
+        if ([status[@"interval_minutes"] respondsToSelector:@selector(longValue)]) {
+            minutes = [status[@"interval_minutes"] longValue];
+        }
+    }
+    item = [menu addItemWithTitle:info action:nil keyEquivalent:@""];
+    [item setEnabled:NO];
+    [menu addItem:[NSMenuItem separatorItem]];
+    NSMenu *every = [[[NSMenu alloc] initWithTitle:@"Save Every"] autorelease];
+    [every setAutoenablesItems:NO];
+    long choices[] = { 0, 1, 2, 5, 15 };
+    for (size_t i = 0; i < sizeof(choices) / sizeof(choices[0]); i++) {
+        NSString *title = choices[i] == 0 ? @"Off"
+            : [NSString stringWithFormat:@"%ld minute%@", choices[i], choices[i] == 1 ? @"" : @"s"];
+        NSMenuItem *choice = [every addItemWithTitle:title action:@selector(sessionInterval:) keyEquivalent:@""];
+        [choice setTarget:self];
+        [choice setTag:choices[i]];
+        [choice setState:minutes == choices[i] ? NSControlStateValueOn : NSControlStateValueOff];
+    }
+    item = [menu addItemWithTitle:@"Save Every" action:nil keyEquivalent:@""];
+    [menu setSubmenu:every forItem:item];
+}
+
+- (void)sessionCommand:(NSString *)arguments
+{
+    const char *command = mylinux_env("MYLINUX_SESSION_CMD");
+    if (!command) {
+        return;
+    }
+    NSString *line = [NSString stringWithFormat:@"%s %@", command, arguments];
+    [NSTask launchedTaskWithExecutableURL:[NSURL fileURLWithPath:@"/bin/sh"] arguments:@[@"-c", line]
+                                    error:NULL terminationHandler:nil];
+}
+
+- (void)sessionSave:(id)sender { [self sessionCommand:@"save"]; }
+- (void)sessionRestore:(id)sender { [self sessionCommand:@"restore"]; }
+- (void)sessionInterval:(id)sender
+{
+    long minutes = [sender tag];
+    [self sessionCommand:minutes ? [NSString stringWithFormat:@"interval %ld", minutes] : @"interval off"];
+}
+
+- (void)showFullScreenPanel
+{
+    if (!mylinux_size_buttons() && !mylinux_session()) {
+        return;
+    }
+    if (!fullscreen_panel) {
+        CGFloat x = 24;
+        NSMutableArray *views = [NSMutableArray array];
+        NSTextField *grip = [NSTextField labelWithString:@"⋮"];
+        [grip setFont:[NSFont systemFontOfSize:13]];
+        [grip setTextColor:[NSColor colorWithWhite:1 alpha:0.6]];
+        [grip setFrame:NSMakeRect(6, 8, 14, 22)];
+        [grip setToolTip:@"Drag to move"];
+        [views addObject:grip];
+        if (mylinux_session()) {
+            NSPopUpButton *session = [[NSPopUpButton alloc] initWithFrame:NSMakeRect(x, 6, 48, 26) pullsDown:YES];
+            [session setBezelStyle:NSBezelStyleToolbar];
+            [session setMenu:[self sessionMenuForPanel:YES]];
+            [self menuNeedsUpdate:[self sessionMenuForPanel:YES]];   /* the face (item 0) exists before the first click */
+            [session setToolTip:@"Session: save, restore, how often it is saved"];
+            [[session cell] setArrowPosition:NSPopUpArrowAtBottom];
+            [[session cell] setImagePosition:NSImageOnly];
+            [views addObject:session];
+            x += 52;
+        }
+        NSImage *image = [NSImage imageWithSystemSymbolName:@"arrow.down.right.and.arrow.up.left"
+                                   accessibilityDescription:@"Exit full screen"];
+        NSButton *button = [NSButton buttonWithImage:image target:self action:@selector(doToggleFullScreen:)];
+        [button setBezelStyle:NSBezelStyleToolbar];
+        [button setToolTip:@"Exit full screen (Control+Command+F)"];
+        [button setFrame:NSMakeRect(x, 6, 32, 26)];
+        [views addObject:button];
+        x += 36;
+        fullscreen_panel = [[NSPanel alloc] initWithContentRect:NSMakeRect(0, 0, x + 2, 38)
+            styleMask:NSWindowStyleMaskBorderless | NSWindowStyleMaskNonactivatingPanel | NSWindowStyleMaskUtilityWindow
+            backing:NSBackingStoreBuffered defer:NO];
+        [fullscreen_panel setMovableByWindowBackground:YES];
+        [fullscreen_panel setLevel:NSStatusWindowLevel];
+        [fullscreen_panel setCollectionBehavior:NSWindowCollectionBehaviorCanJoinAllSpaces |
+                                                NSWindowCollectionBehaviorFullScreenAuxiliary |
+                                                NSWindowCollectionBehaviorStationary];
+        [fullscreen_panel setOpaque:NO];
+        [fullscreen_panel setBackgroundColor:[NSColor colorWithWhite:0.15 alpha:0.8]];
+        [fullscreen_panel setHidesOnDeactivate:NO];
+        [fullscreen_panel setFloatingPanel:YES];
+        [[fullscreen_panel contentView] setWantsLayer:YES];
+        [[[fullscreen_panel contentView] layer] setCornerRadius:8];
+        for (NSView *view in views) {
+            [[fullscreen_panel contentView] addSubview:view];
+        }
+    }
+    /* top right corner, 24 points below the menu bar and 2 in from the edge; where the user dragged it last time
+     * when that is still on this screen */
+    NSScreen *screen = [[cocoaView window] screen];
+    NSRect frame = [screen frame];
+    if (!fullscreen_panel_placed || !NSContainsRect(frame, [fullscreen_panel frame])) {
+        CGFloat top = MIN(NSMaxY([screen visibleFrame]), NSMaxY(frame) - [screen safeAreaInsets].top);
+        CGFloat width = [fullscreen_panel frame].size.width;
+        [fullscreen_panel setFrameOrigin:NSMakePoint(NSMaxX(frame) - width - 2, top - 38 - 24)];
+        fullscreen_panel_placed = true;
+    }
+    [fullscreen_panel orderFront:nil];
+}
+
+- (void)sizeButtonRememberBase
+{
+    if (size_button_base.width == 0) {
+        size_button_base = [[[cocoaView window] contentView] frame].size;
+    }
+}
+
+- (void)sizeButtonSetContentSize:(NSSize)size
+{
+    NSWindow *window = [cocoaView window];
+    if ([window styleMask] & NSWindowStyleMaskFullScreen) {
+        [window toggleFullScreen:nil];
+        return;
+    }
+    if (!([window styleMask] & NSWindowStyleMaskResizable)) {
+        [window setStyleMask:[window styleMask] | NSWindowStyleMaskResizable];
+    }
+    NSRect visible = [[window screen] visibleFrame];
+    NSRect frame = [window frame];
+    CGFloat chrome = frame.size.height - [[window contentView] frame].size.height;
+    size.width = MIN(size.width, visible.size.width);
+    size.height = MIN(size.height, visible.size.height - chrome);
+    [window setContentSize:size];
+    frame = [window frame];
+    if (NSMaxX(frame) > NSMaxX(visible)) frame.origin.x = NSMaxX(visible) - frame.size.width;
+    if (NSMaxY(frame) > NSMaxY(visible)) frame.origin.y = NSMaxY(visible) - frame.size.height;
+    if (frame.origin.x < visible.origin.x) frame.origin.x = visible.origin.x;
+    if (frame.origin.y < visible.origin.y) frame.origin.y = visible.origin.y;
+    [window setFrameOrigin:frame.origin];
+}
+
+- (void)sizeButtonLarger:(id)sender
+{
+    [self sizeButtonRememberBase];
+    NSSize size = [[[cocoaView window] contentView] frame].size;
+    [self sizeButtonSetContentSize:NSMakeSize(round(size.width * 1.1), round(size.height * 1.1))];
+}
+
+- (void)sizeButtonBase:(id)sender
+{
+    [self sizeButtonRememberBase];
+    [self sizeButtonSetContentSize:size_button_base];
+}
