+- (void)sizeButtonSetContentSize:(NSSize)size
+{
+    NSWindow *window = [cocoaView window];
+    if ([window styleMask] & NSWindowStyleMaskFullScreen) {
+        [window toggleFullScreen:nil];
+        return;
+    }
+    mylinux_user_sized = true;
+    if (!([window styleMask] & NSWindowStyleMaskResizable)) {
+        [window setStyleMask:[window styleMask] | NSWindowStyleMaskResizable];
+        if (!zoom_to_fit_item) {
+            zoom_to_fit_item = mylinux_zoom_item([NSApp mainMenu]);
+        }
+        [zoom_to_fit_item setState:NSControlStateValueOn];
+    }
+    NSRect visible = [[window screen] visibleFrame];
+    NSRect frame = [window frame];
+    CGFloat chrome = frame.size.height - [[window contentView] frame].size.height;
+    size.width = MIN(size.width, visible.size.width);
+    size.height = MIN(size.height, visible.size.height - chrome);
+    [window setContentSize:size];
+    frame = [window frame];
+    if (NSMaxX(frame) > NSMaxX(visible)) frame.origin.x = NSMaxX(visible) - frame.size.width;
+    if (NSMaxY(frame) > NSMaxY(visible)) frame.origin.y = NSMaxY(visible) - frame.size.height;
+    if (frame.origin.x < visible.origin.x) frame.origin.x = visible.origin.x;
+    if (frame.origin.y < visible.origin.y) frame.origin.y = visible.origin.y;
+    [window setFrameOrigin:frame.origin];
+}
