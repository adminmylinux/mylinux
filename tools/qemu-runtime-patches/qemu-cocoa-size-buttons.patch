+- (void)sessionCommand:(NSArray<NSString *> *)words
+{
+    const char *command = mylinux_env("MYLINUX_SESSION_CMD");
+    const char *share = mylinux_env("MYLINUX_SESSION_SHARE");
+    if (!command || !share) {
+        return;
+    }
+    /* the helper is run directly, as an argument list: a space or a quote in the app's or the share's path is
+     * only a character, and UTF-8 paths arrive as they are */
+    NSString *helper = [NSString stringWithUTF8String:command];
+    NSString *folder = [NSString stringWithUTF8String:share];
+    if (!helper || !folder) {
+        return;
+    }
+    NSMutableArray<NSString *> *arguments = [NSMutableArray arrayWithObject:folder];
+    [arguments addObjectsFromArray:words];
+    [NSTask launchedTaskWithExecutableURL:[NSURL fileURLWithPath:helper] arguments:arguments
+                                    error:NULL terminationHandler:nil];
+}
+
+- (void)sessionSave:(id)sender { [self sessionCommand:@[@"save"]]; }
+- (void)sessionRestore:(id)sender { [self sessionCommand:@[@"restore"]]; }
+- (void)sessionInterval:(id)sender
+{
+    long minutes = [sender tag];
+    [self sessionCommand:@[@"interval", minutes ? [NSString stringWithFormat:@"%ld", minutes] : @"off"]];
+}
