# myLinux: GNOME's defaults in the launcher's desktops (the window is the Mac's to lock): nothing locks, blanks or
# sleeps (the power button is GNOME's: in a virtual machine it shuts down), and the dock has Firefox (Fedora's name for
# it, and EL's; GNOME leaves out the one not there), the terminal, Files and the text editor
[org/gnome/desktop/session]
idle-delay=uint32 0

[org/gnome/desktop/screensaver]
lock-enabled=false

[org/gnome/desktop/lockdown]
disable-lock-screen=true

[org/gnome/settings-daemon/plugins/power]
sleep-inactive-ac-type='nothing'

[org/gnome/shell]
welcome-dialog-last-shown-version='999'
favorite-apps=['org.mozilla.firefox.desktop', 'firefox.desktop', 'org.gnome.Ptyxis.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.TextEditor.desktop']
