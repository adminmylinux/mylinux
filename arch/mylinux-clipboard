#!/usr/bin/env python3
"""myLinux: the guest side of the clipboard bridge in the Arch (KDE Plasma) image.

The launcher's bridge on the Mac (OmarchyClipboard.swift) speaks Try Omarchy's protocol on the virtio serial port
dev.tryomarchy.clipboard: one JSON object per line each way,
    {"type": "clipboard", "format": "text/plain;charset=utf-8" | "image/png", "data": "<base64>"}
and {"type": "sync"} from here asks for the Mac's clipboard. This agent sets Plasma's clipboard with wl-copy and
watches it with wl-paste --watch. What it was just given from the Mac is not sent back (a fingerprint, as the Mac
side does it).
"""
import base64, hashlib, json, os, subprocess, sys, threading, time

PORT = "/dev/virtio-ports/dev.tryomarchy.clipboard"
TEXT, PNG = "text/plain;charset=utf-8", "image/png"
MAX = 16 * 1024 * 1024
ECHO_WINDOW = 2.0

lock = threading.Lock()
last_in = {"fp": None, "at": 0.0}       # what the Mac last gave us
last_out = {"fp": None}                  # what we last sent


def log(m):
    print(f"mylinux-clipboard: {m}", file=sys.stderr, flush=True)


def fingerprint(mime, payload):
    h = hashlib.sha256(); h.update(mime.encode()); h.update(b"\0"); h.update(payload)
    return h.hexdigest()


def send(fd, mime, payload):
    line = json.dumps({"type": "clipboard", "format": mime, "data": base64.b64encode(payload).decode()}, sort_keys=True)
    os.write(fd, line.encode() + b"\n")


def from_mac(fd):
    buf = b""
    while True:
        chunk = os.read(fd, 65536)
        if not chunk:
            time.sleep(0.2); continue
        buf += chunk
        while b"\n" in buf:
            line, buf = buf.split(b"\n", 1)
            try:
                m = json.loads(line)
            except ValueError:
                continue
            if m.get("type") != "clipboard" or m.get("format") not in (TEXT, PNG):
                continue
            try:
                payload = base64.b64decode(m["data"])
            except (ValueError, KeyError, TypeError):
                continue
            if not payload or len(payload) > MAX:
                continue
            mime = m["format"]
            with lock:
                last_in["fp"], last_in["at"] = fingerprint(mime, payload), time.monotonic()
            # wl-copy stays to serve the selection; it is replaced by the next copy
            subprocess.Popen(["wl-copy", "--type", mime], stdin=subprocess.PIPE, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL).communicate(payload)


def current():
    """Plasma's clipboard now: (mime, payload) for text or a PNG, else None."""
    try:
        types = subprocess.run(["wl-paste", "--list-types"], capture_output=True, timeout=3).stdout.decode().split()
    except (OSError, subprocess.TimeoutExpired):
        return None
    if PNG in types:
        want, mime = PNG, PNG
    elif any(t.startswith("text/plain") or t in ("UTF8_STRING", "STRING", "TEXT") for t in types):
        want, mime = ("text/plain;charset=utf-8" if "text/plain;charset=utf-8" in types else "text/plain"), TEXT
    else:
        return None
    try:
        out = subprocess.run(["wl-paste", "--no-newline", "--type", want], capture_output=True, timeout=5).stdout
    except (OSError, subprocess.TimeoutExpired):
        return None
    return (mime, out) if out and len(out) <= MAX else None


def to_mac(fd):
    # one line per change of the selection
    w = subprocess.Popen(["wl-paste", "--watch", "echo", "changed"], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    for _ in w.stdout:
        got = current()
        if not got:
            continue
        mime, payload = got
        fp = fingerprint(mime, payload)
        with lock:
            echo = fp == last_in["fp"] and time.monotonic() - last_in["at"] < ECHO_WINDOW
            if echo or fp == last_out["fp"]:
                continue
            last_out["fp"] = fp
        send(fd, mime, payload)
    err = w.stderr.read().decode().strip()
    raise SystemExit(f"wl-paste --watch ended: {err or w.wait()}")


def main():
    if not os.environ.get("WAYLAND_DISPLAY"):
        sys.exit("no WAYLAND_DISPLAY: start with the desktop (graphical-session.target)")
    for _ in range(30):
        if os.path.exists(PORT):
            break
        time.sleep(1)
    else:
        log(f"{PORT} is not there (the machine was started without the clipboard); waiting")
        while not os.path.exists(PORT):
            time.sleep(10)
    fd = os.open(PORT, os.O_RDWR)
    os.write(fd, b'{"type": "sync"}\n')
    threading.Thread(target=from_mac, args=(fd,), daemon=True).start()
    to_mac(fd)


if __name__ == "__main__":
    main()
