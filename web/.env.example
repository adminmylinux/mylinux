# Copy to /opt/mylinux-web/.env on the server. Never commit the real file.

# Clerk application for mylinux.app (dashboard.clerk.com › API keys).
# Without both keys the landing page and docs still work, but Sign in shows
# a "not configured yet" notice.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Origins whose browser sessions are accepted (comma separated)
APP_ORIGINS=https://mylinux.app,https://www.mylinux.app

# Postgres (used by both containers)
POSTGRES_USER=mylinux
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mylinux
