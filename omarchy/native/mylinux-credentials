#!/bin/bash
# myLinux: what the launcher hands an Omarchy 4.5 machine at each start, as systemd credentials (SMBIOS type 11, from
# run-omarchy.sh: the disk is btrfs, so nothing is written into it from the Mac), put where this machine's own pieces
# read them. Runs as root before Omarchy's first-start setup and the login (mylinux-credentials.service).
#   mylinux.session        the session tool (omarchy/session/omarchy-session) -> /usr/local/bin/omarchy-session, when it
#                          differs: an agent from an older launcher learns what the Mac window asks of it now
#   mylinux.answers        the first-start answers -> /var/lib/mylinux/answers (root's alone), for /var/lib/mylinux/provision
#   mylinux.tools-request  with mylinux.tools-script: Install Claude Code / Codex from the launcher's dialog ->
#                          /var/lib/mylinux/tools/request.json and claude_setup.py, the same
# The last two come only at a machine's first start, and only while Omarchy's first-start setup waits; provision
# removes them (the password and a token can be in them) when it is done.
set -u
c=${CREDENTIALS_DIRECTORY:-}
[ -n "$c" ] || exit 0
dir=/var/lib/mylinux
if [ -s "$c/mylinux.session" ] && ! cmp -s "$c/mylinux.session" /usr/local/bin/omarchy-session; then
  install -m 0755 "$c/mylinux.session" /usr/local/bin/omarchy-session.new && mv -f /usr/local/bin/omarchy-session.new /usr/local/bin/omarchy-session
  echo "the session tool is the launcher's now"
fi
if [ -f /var/lib/omarchy/provisioning/pending ] && [ -x "$dir/provision" ]; then
  if [ -s "$c/mylinux.answers" ]; then
    install -m 0600 "$c/mylinux.answers" "$dir/answers"
    echo "first-start answers for $(sed -n 's/^username=//p' "$dir/answers" | head -n 1)"
  fi
  if [ -s "$c/mylinux.tools-request" ] && [ -s "$c/mylinux.tools-script" ]; then
    install -d -m 0700 "$dir/tools"
    install -m 0600 "$c/mylinux.tools-request" "$dir/tools/request.json"
    install -m 0644 "$c/mylinux.tools-script" "$dir/tools/claude_setup.py"
    echo "Claude Code and Codex to set up in the new account"
  fi
fi
exit 0
