# myLinux: the launcher's credentials of this start, in place before Omarchy's first-start setup and the login
[Unit]
Description=myLinux: what the launcher gives this start
Before=omarchy-provision-owner.service display-manager.service

[Service]
Type=oneshot
ImportCredential=mylinux.*
ExecStart=/usr/lib/mylinux/credentials

[Install]
WantedBy=multi-user.target
