#!/bin/sh
# Fetch Omarchy's own background images (the photos) for all built-in themes into
# ~/.config/mylinux/themes/<theme>/backgrounds/, where they are merged with the generated ones.
# One download of the Omarchy repository tarball; no GitHub API, no git.
set -e
DEST="${HOME:-/root}/.config/mylinux/themes"; mkdir -p "$DEST"
TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT
echo "Downloading the Omarchy repository (backgrounds for all themes)..."
curl -fL --progress-bar -o "$TMP/omarchy.tgz" https://codeload.github.com/basecamp/omarchy/tar.gz/HEAD
echo "Extracting backgrounds..."
gunzip -c "$TMP/omarchy.tgz" | tar -x -C "$TMP" --wildcards '*/themes/*/backgrounds/*' '*/themes/*/colors.toml' '*/themes/*/light.mode' 2>/dev/null || \
gunzip -c "$TMP/omarchy.tgz" | tar -x -C "$TMP"
n=0
for d in "$TMP"/*/themes/*/; do
  t=$(basename "$d"); mkdir -p "$DEST/$t/backgrounds"
  [ -f "$DEST/$t/colors.toml" ] || cp "$d/colors.toml" "$DEST/$t/" 2>/dev/null || true
  [ -f "$d/light.mode" ] && touch "$DEST/$t/light.mode"
  # Replace this theme's downloaded photos wholesale, so a previous broken/partial download can't linger.
  # (Generated wallpapers live in /usr/share/mylinux and are untouched.)
  rm -f "$DEST/$t/backgrounds"/*.webp
  for f in "$d"/backgrounds/*; do
    b=$(basename "$f")
    # Skip anything that is not actually an image (e.g. a saved 404 page): must start with a known magic.
    case $(dd if="$f" bs=1 count=4 2>/dev/null | od -An -tx1 | tr -d ' \n') in
      89504e47|ffd8ff*|52494646) cp "$f" "$DEST/$t/backgrounds/$b" && n=$((n+1)) ;;
    esac
  done
done
# Qt in this image has no WebP plugin: convert .webp -> .png (the shell binary does it with libwebp)
echo "Converting WebP images..."
SHELL_BIN=/usr/bin/myshell; [ -x /mnt/share/myshell ] && SHELL_BIN=/mnt/share/myshell
"$SHELL_BIN" --convert-webp "$DEST" 2>&1 | grep -v "^$" || true
echo "Done: $n background images for $(ls "$DEST" | wc -l) themes. Cycle with ⌘⌃Space, pick a theme with ⌘⌃⇧Space."
