#!/bin/sh
# Run a program from the Debian "apps disk" (chroot at /mnt/apps) as a Wayland client of the shell.
# Usage: apps-run chromium [args]      apps-run apt install firefox       apps-run bash
# The chroot mounts and helper files are prepared once per boot (S45apps -> apps-mounts); this only checks them.
A=/mnt/apps
# APPS_RUN_DRYRUN=1 (tests): print the secret policy and the lines that would be exported, run nothing.
[ "${APPS_RUN_DRYRUN:-}" = 1 ] || apps-mounts check || exit 1
# Keep the caller's working directory when the chroot has it too (/root and /tmp are the same directories).
CWD=/root; case "$PWD" in /root|/root/*|/tmp|/tmp/*) CWD="$PWD";; esac
# Saved API keys (Settings panel, ~/.config/mylinux/secrets.env) reach only the programs that need them:
# coding agents, shells and developer tools. Browsers, Remmina and other GUI apps get none. The file is data
# (KEY=value lines), never sourced; APPS_SECRETS=all|none overrides the choice for one launch.
policy="${APPS_SECRETS:-}"
if [ -z "$policy" ]; then
  case "${1##*/}" in
    claude|codex|sh|bash|dash|zsh|fish|node|npm|npx|bun|deno|python|python3|pip|pip3|git|gh|aider|opencode|env|apt|apt-get) policy=all ;;
    *) policy=none ;;
  esac
fi
SECRETS_FILE="${SECRETS_FILE:-/root/.config/mylinux/secrets.env}"; LIB="${MYLINUX_LIB:-/usr/lib/mylinux}"
if [ "${APPS_RUN_DRYRUN:-}" = 1 ]; then
  echo "policy=$policy"
  if [ "$policy" = all ] && [ -f "$SECRETS_FILE" ]; then . "$LIB/secrets.sh"; secrets_filter < "$SECRETS_FILE"; fi
  exit 0
fi
SECRETS=0
if [ "$policy" = all ] && [ -f "$SECRETS_FILE" ]; then
  . "$LIB/secrets.sh"
  # validated lines go through an unlinked 0600 file on fd 3; the program's stdin stays untouched
  tmp=$(mktemp /run/apps-secrets.XXXXXX) && chmod 600 "$tmp" && secrets_filter < "$SECRETS_FILE" > "$tmp" \
    && exec 3< "$tmp" && SECRETS=1
  rm -f "$tmp"
fi
exec chroot $A /usr/bin/env -i HOME=/root USER=root TERM="${TERM:-foot}" PATH=/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    LANG=C.UTF-8 WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}" XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" XDG_SESSION_TYPE=wayland \
    GDK_BACKEND=wayland QT_QPA_PLATFORM=wayland MOZ_ENABLE_WAYLAND=1 BROWSER=/usr/local/bin/mylinux-browser MYLINUX_SECRETS=$SECRETS \
    sh -c 'if [ "$MYLINUX_SECRETS" = 1 ]; then while IFS= read -r l <&3; do [ -n "$l" ] && export "$l"; done; exec 3<&-; fi; unset MYLINUX_SECRETS
           cd "$1" 2>/dev/null || cd /root; shift; exec "$@"' sh "$CWD" "$@"
