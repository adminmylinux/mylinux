#!/bin/sh
# Run a program from the Debian "apps disk" (chroot at /mnt/apps) as a Wayland client of the shell.
# Usage: apps-run chromium [args]      apps-run apt install firefox       apps-run bash
A=/mnt/apps
if ! mountpoint -q $A; then echo "apps-run: no apps disk mounted at $A (run.sh attaches out/apps.img)" >&2; exit 1; fi
for d in dev proc sys tmp; do mountpoint -q $A/$d || mount --bind /$d $A/$d; done
mountpoint -q $A/dev/pts || mount -t devpts devpts $A/dev/pts 2>/dev/null
mkdir -p $A/dev/shm; mountpoint -q $A/dev/shm || mount -t tmpfs tmpfs $A/dev/shm
mkdir -p "$A$XDG_RUNTIME_DIR"; mountpoint -q "$A$XDG_RUNTIME_DIR" || mount --bind "$XDG_RUNTIME_DIR" "$A$XDG_RUNTIME_DIR"
# the Mac share folder, so apps (file dialogs) can read files dropped into share/ on the Mac
if mountpoint -q /mnt/share; then mkdir -p $A/mnt/share; mountpoint -q $A/mnt/share || mount --bind /mnt/share $A/mnt/share; fi
cp -f /etc/resolv.conf $A/etc/resolv.conf 2>/dev/null
# helper scripts inside the chroot: default browser for xdg-open / $BROWSER (Claude Code login etc.)
mkdir -p $A/usr/local/bin
[ -x $A/usr/local/bin/mylinux-browser ] || cat > $A/usr/local/bin/mylinux-browser <<'EOS'
#!/bin/sh
exec chromium --ozone-platform=wayland --no-sandbox --disable-gpu --disable-dev-shm-usage --password-store=basic --no-first-run "$@"
EOS
chmod +x $A/usr/local/bin/mylinux-browser
# Debian's /usr/bin/chromium wrapper reads /etc/chromium.d/*: make every launch path (xdg-open, .desktop files) use
# the flags this compositor needs.
mkdir -p $A/etc/chromium.d
[ -f $A/etc/chromium.d/mylinux ] || cat > $A/etc/chromium.d/mylinux <<'EOS'
export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --ozone-platform=wayland --no-sandbox --disable-gpu --disable-dev-shm-usage --password-store=basic"
EOS
# Keep the caller's working directory when the chroot has it too (/root and /tmp are the same directories).
CWD=/root; case "$PWD" in /root|/root/*|/tmp|/tmp/*) CWD="$PWD";; esac
exec chroot $A /usr/bin/env -i HOME=/root USER=root TERM="${TERM:-foot}" PATH=/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    LANG=C.UTF-8 WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}" XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" XDG_SESSION_TYPE=wayland \
    GDK_BACKEND=wayland QT_QPA_PLATFORM=wayland MOZ_ENABLE_WAYLAND=1 BROWSER=/usr/local/bin/mylinux-browser \
    sh -c 'cd "$1" 2>/dev/null || cd /root; shift; exec "$@"' sh "$CWD" "$@"
