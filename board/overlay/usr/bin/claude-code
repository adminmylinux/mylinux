#!/bin/sh
# Claude Code (CLI) from the apps disk; installs itself on first launch.
# Typed in a terminal (also as `claude`) it runs right there; from the launcher/menu it gets its own window.
if [ -t 0 ] && [ -t 1 ]; then
  apps-run test -x /root/.local/bin/claude 2>/dev/null || { echo "Claude Code is not on the apps disk yet - installing it (needs network, ~1 min)..."; apps-setup-ai claude || exit 1; }
  exec apps-run claude "$@"
fi
if ! apps-run test -x /root/.local/bin/claude 2>/dev/null; then
  exec foot -T "Installing Claude Code" sh -c '
    echo "Claude Code is not on the apps disk yet - installing it now (needs network, ~1 min)..."; echo
    if apps-setup-ai claude; then echo; echo "Installed. Starting Claude Code..."; sleep 1; exec apps-run claude; fi
    echo; echo "Installation failed - see messages above. Press Enter to close."; read x'
fi
exec foot -T "Claude Code" -a claude-code apps-run claude "$@"
