#!/bin/sh
# The Debian base on the apps disk (the pinned minimal rootfs every app installs into), put there the first time
# something needs it, in the terminal that asked (apps-install, apps-setup-ai, apps-update). Exit 0 when it is there.
[ -f /mnt/apps/.mylinux/stage-rootfs-done ] && apps-mounts check >/dev/null 2>&1 && exit 0
mountpoint -q /mnt/apps || { echo "No apps disk is mounted (see /run/apps-disk.info); apps cannot be installed." >&2; exit 1; }
printf '\033[1mFirst the Debian base goes onto the apps disk (once, about a minute).\033[0m\n'
apps-setup base
