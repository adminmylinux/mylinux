#!/bin/sh
# OpenAI Codex CLI from the apps disk in its own terminal window; installs itself on first launch.
if ! apps-run test -x /root/.local/bin/codex 2>/dev/null; then
  exec foot -T "Installing Codex" sh -c '
    echo "Codex is not on the apps disk yet - installing it now (needs network, ~1 min)..."; echo
    if apps-setup-ai codex; then echo; echo "Installed. Starting Codex..."; sleep 1; exec apps-run sh -lc "cd /root && exec /root/.local/bin/codex"; fi
    echo; echo "Installation failed - see messages above. Press Enter to close."; read x'
fi
exec foot -T "Codex" -a codex apps-run sh -lc 'cd /root && exec /root/.local/bin/codex "$@"' -- "$@"
