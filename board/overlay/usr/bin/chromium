#!/bin/sh
# Chromium from the apps disk, tuned for this compositor (software GL, root inside the chroot); installs itself (with
# the fonts, GL and clipboard packages the desktop uses) on first launch.
exec apps-install "Chromium" "ca-certificates fonts-dejavu-core fonts-liberation libgl1 libegl1 libgles2 mesa-libgallium dbus xdg-utils wl-clipboard curl chromium chromium-sandbox" \
  /usr/bin/chromium apps-run chromium --ozone-platform=wayland --no-sandbox --test-type --force-prefers-reduced-motion --disable-gpu --disable-dev-shm-usage \
    --password-store=basic --no-first-run --disable-features=UseOzonePlatform,WaylandFractionalScaleV1 \
    --enable-features=UseOzonePlatform "$@"
