#!/bin/sh
# Install the coding agents onto the apps disk: Claude Code (Anthropic's native installer) and Codex (a pinned
# GitHub release, sha256 from the manifest). Usage: apps-setup-ai [claude|codex|all] [--latest]
#   --latest: Codex from the newest GitHub release instead of the pinned one (no checksum available for it,
#   TLS only); the pinned version is what a repair reinstalls, so nothing drifts silently.
set -e
. /usr/lib/mylinux/fetch.sh
WHAT=all; LATEST=0
for a in "$@"; do case "$a" in claude|codex|all) WHAT=$a ;; --latest) LATEST=1 ;; *) echo "usage: apps-setup-ai [claude|codex|all] [--latest]" >&2; exit 2 ;; esac; done
apps-base || exit 1
apps-mounts check
apps-run apt-get update -q
# no recommends: xdg-utils would otherwise bring X11, Mesa and LLVM (hundreds of MB) the agents do not use
apps-run env DEBIAN_FRONTEND=noninteractive apt-get install -y -q --no-install-recommends curl wl-clipboard xdg-utils ca-certificates
rc=0
if [ "$WHAT" = all ] || [ "$WHAT" = claude ]; then
  echo "== Claude Code (installer from $CLAUDE_INSTALLER_URL; upstream publishes no checksum)"
  if fetch_verified "$CLAUDE_INSTALLER_URL" "$CLAUDE_INSTALLER_SHA256" /mnt/apps/tmp/claude-install.sh \
     && apps-run bash /tmp/claude-install.sh && apps-run test -x /root/.local/bin/claude; then
    echo "Claude Code installed."
  else echo "Claude Code did not install." >&2; rc=1; fi
  rm -f /mnt/apps/tmp/claude-install.sh
  # The home directory is this VM's workspace: pre-accept Claude Code's "trust this folder?" question for it
  # (only on a fresh config; an existing file keeps whatever was answered).
  [ -f /root/.claude.json ] || printf '{"projects":{"/root":{"hasTrustDialogAccepted":true}}}\n' > /root/.claude.json
fi
if [ "$WHAT" = all ] || [ "$WHAT" = codex ]; then
  URL="$CODEX_URL"; SUM="$CODEX_SHA256"; VER="$CODEX_VERSION"
  if [ $LATEST = 1 ]; then URL=https://github.com/openai/codex/releases/latest/download/codex-aarch64-unknown-linux-musl.tar.gz; SUM=""; VER=latest; fi
  echo "== Codex $VER"
  if fetch_verified "$URL" "$SUM" /tmp/codex.tgz && mkdir -p /tmp/codex-x && gunzip -c /tmp/codex.tgz | tar -x -C /tmp/codex-x \
     && [ -f /tmp/codex-x/codex-aarch64-unknown-linux-musl ] \
     && mkdir -p /root/.local/bin && cp /tmp/codex-x/codex-aarch64-unknown-linux-musl /root/.local/bin/codex.tmp \
     && chmod +x /root/.local/bin/codex.tmp && mv -f /root/.local/bin/codex.tmp /root/.local/bin/codex \
     && apps-run codex --version; then
    echo "Codex installed."
  else echo "Codex did not install." >&2; rc=1; fi
  rm -rf /tmp/codex.tgz /tmp/codex-x
fi
apps-path
[ $rc -eq 0 ] && echo "done." || echo "some agents did not install (see above); run apps-setup-ai again." >&2
exit $rc
