#!/bin/sh
# Mac -> guest text clipboard over the share folder: run.sh mirrors the Mac clipboard into
# share/clipboard/mac.txt; this applies it as the guest selection with wl-copy (wl-clipboard from the apps
# disk; its helper surface is kept invisible by the compositor). Guest -> Mac is on request: clipboard-send
# (⌘⌃C). Started by S99shell.
. /etc/profile.d/qt.sh
D=/mnt/share/clipboard; MAC=$D/mac.txt
until [ -S "$XDG_RUNTIME_DIR/wayland-0" ] && [ -x /mnt/apps/usr/bin/wl-copy ] && mountpoint -q /mnt/share; do sleep 2; done
mkdir -p "$D"
LAST_M=""; LAST_TEXT=""
while sleep 0.5; do
  [ -f "$MAC" ] || continue
  M=$(stat -c %Y "$MAC" 2>/dev/null); [ "$M" != "$LAST_M" ] || continue
  LAST_M=$M; T=$(cat "$MAC")
  if [ -n "$T" ] && [ "$T" != "$LAST_TEXT" ]; then LAST_TEXT=$T; printf '%s' "$T" | apps-run wl-copy 2>/dev/null; fi
done
