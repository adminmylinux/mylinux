# Download manifest for the apps disk: pinned URLs and sha256 sums, read by apps-setup and apps-setup-ai
# (/usr/lib/mylinux/fetch.sh). Refresh with tools/manifest-update.sh, which prints the new values after
# downloading and hashing them; commit the result so the image records what it installs.
MANIFEST_VERSION=1
# Debian trixie arm64 minimal rootfs from debuerreotype's docker-debian-artifacts, pinned to a commit of the
# dist-arm64v8 branch (the branch head moves with every Debian point release).
DEBIAN_ROOTFS_URL=https://raw.githubusercontent.com/debuerreotype/docker-debian-artifacts/f73bd086e8d0e5e1c8b838ccc442bf24eb3ea205/trixie/oci/blobs/rootfs.tar.gz
DEBIAN_ROOTFS_SHA256=7f50a08a25277c02b8dfc99818a21e12083215981e0aa03cb07cb74c9116f205
DEBIAN_ROOTFS_NOTE="Debian 13.6 (debuerreotype epoch 1787529600)"
# OpenAI Codex CLI, a GitHub release asset (musl static build for arm64)
CODEX_VERSION=rust-v0.154.0
CODEX_URL=https://github.com/openai/codex/releases/download/rust-v0.154.0/codex-aarch64-unknown-linux-musl.tar.gz
CODEX_SHA256=583b48df32804213bdcd338c2e5adb06b34340821fa757a726cc0a524fa33c27
# Claude Code's native installer: Anthropic publishes no checksum or signature for install.sh, and the script
# itself downloads the current release. It is fetched to a staged file (exit status checked) and then run;
# the transport (TLS to claude.ai) is the only verification. Left empty on purpose, not invented.
CLAUDE_INSTALLER_URL=https://claude.ai/install.sh
CLAUDE_INSTALLER_SHA256=
