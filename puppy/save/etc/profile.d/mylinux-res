# myLinux: the desktop's size. X takes the display's preferred mode, which in this machine's window is the small boot
# screen's; the size the machine was started with (mylinux.res=WxH on the kernel line, from run-omarchy.sh) is made
# the preferred one instead. Sourced by /etc/profile before X starts; in later shells (a terminal) it does nothing.
if [ -z "$DISPLAY" ] && [ "$(id -u)" = 0 ]; then
  mylinux_res=$(sed -n 's/.*mylinux\.res=\([0-9][0-9]*x[0-9][0-9]*\).*/\1/p' /proc/cmdline)
  if [ -n "$mylinux_res" ]; then
    mylinux_mode=$(gtf "${mylinux_res%x*}" "${mylinux_res#*x}" 60 2>/dev/null | sed -n 's/^ *Modeline *"[^"]*" *//p')
    if [ -n "$mylinux_mode" ]; then
      mkdir -p /etc/X11/xorg.conf.d
      printf 'Section "Monitor"\n\tIdentifier "Virtual-1"\n\tModeline "mylinux" %s\n\tOption "PreferredMode" "mylinux"\nEndSection\n' "$mylinux_mode" \
        > /etc/X11/xorg.conf.d/90-mylinux-res.conf
    fi
  fi
  unset mylinux_res mylinux_mode
fi
