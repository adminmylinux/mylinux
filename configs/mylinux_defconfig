# --- target & toolchain ---
BR2_aarch64=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_TOOLCHAIN_BUILDROOT_LOCALE=y
BR2_CCACHE=y
BR2_DL_DIR="$(HOME)/br/dl"
BR2_GLOBAL_PATCH_DIR="board/qemu/patches $(BR2_EXTERNAL_MYLINUX_PATH)/patches"
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_PRIMARY_SITE="https://sources.buildroot.net"

# --- system ---
BR2_TARGET_GENERIC_HOSTNAME="mylinux"
BR2_TARGET_GENERIC_ISSUE="mylinux"
BR2_TARGET_GENERIC_GETTY_PORT="ttyAMA0"
# serial console: straight to a root shell, no login prompt (debug console of a RAM appliance)
BR2_TARGET_GENERIC_GETTY_OPTIONS="-n -l /bin/sh"
BR2_SYSTEM_DHCP="eth0"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_MYLINUX_PATH)/board/overlay"
BR2_GENERATE_LOCALE="en_US.UTF-8"
# eudev: libinput needs libudev to enumerate input devices (Qt's libinput backend maps Super -> Meta)
# BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS is not set
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_PACKAGE_LIBINPUT=y

# --- first-boot apps-disk setup: format the disk, fetch a Debian rootfs over https, resize ---
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_PACKAGE_LIBCURL_OPENSSL=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_RESIZE2FS=y
BR2_PACKAGE_XZ=y
# webp decoder (dwebp) for Omarchy backgrounds; Qt has no webp plugin in this image
BR2_PACKAGE_WEBP=y
BR2_TARGET_TZ_INFO=y
BR2_TARGET_LOCALTIME="Europe/Oslo"

# --- kernel: Buildroot's qemu aarch64 config + our fragment ---
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.7"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="board/qemu/aarch64-virt/linux.config"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_MYLINUX_PATH)/board/linux.fragment"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_18=y

# --- rootfs: initramfs only ---
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
# BR2_TARGET_ROOTFS_EXT2 is not set
# BR2_TARGET_ROOTFS_TAR is not set

# --- Qt 6 (Stage B: eglfs on Mesa llvmpipe via GBM/KMS; linuxfb kept as fallback) ---
BR2_PACKAGE_QT6=y
BR2_PACKAGE_QT6BASE=y
BR2_PACKAGE_QT6BASE_GUI=y
BR2_PACKAGE_QT6BASE_WIDGETS=y
BR2_PACKAGE_QT6BASE_LINUXFB=y
BR2_PACKAGE_QT6BASE_FONTCONFIG=y
BR2_PACKAGE_QT6BASE_HARFBUZZ=y
BR2_PACKAGE_QT6BASE_PNG=y
BR2_PACKAGE_QT6BASE_JPEG=y
BR2_PACKAGE_QT6BASE_NETWORK=y
BR2_PACKAGE_QT6BASE_EGLFS=y
BR2_PACKAGE_QT6BASE_OPENGL_ES2=y
BR2_PACKAGE_QT6BASE_DEFAULT_QPA="eglfs"
BR2_PACKAGE_QT6DECLARATIVE=y
BR2_PACKAGE_QT6DECLARATIVE_QUICK=y
BR2_PACKAGE_QT6SVG=y
BR2_PACKAGE_QT6SHADERTOOLS=y
BR2_PACKAGE_DEJAVU=y
BR2_PACKAGE_DEJAVU_SANS=y

# --- Mesa: software GL (llvmpipe) rendered into KMS dumb buffers on the virtio-gpu ---
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_LLVM=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_LLVMPIPE=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_MESA3D_GBM=y

# --- desktop shell: Qt Wayland compositor + clients ---
BR2_PACKAGE_QT6WAYLAND=y
BR2_PACKAGE_QT6WAYLAND_COMPOSITOR=y
BR2_PACKAGE_MESA3D_LEGACY_BIND_WAYLAND_DISPLAY=y
BR2_PACKAGE_XKEYBOARD_CONFIG=y
BR2_PACKAGE_FOOT=y
BR2_PACKAGE_TAILSCALE=y
BR2_PACKAGE_DEJAVU_MONO=y
BR2_PACKAGE_INTER=y

# --- our packages ---
BR2_PACKAGE_MYAPP=y
BR2_PACKAGE_MYSHELL=y
